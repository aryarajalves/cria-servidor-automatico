# Autenticação Mestre da Aplicação [OBRIGATÓRIO]
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123

# Cloudflare (Opcional - pode ser configurado via UI) [OPCIONAL]
# Token da Cloudflare para automação de DNS (Global)
CLOUDFLARE_API_TOKEN=seu_token_aqui

# Chave secreta para assinatura dos tokens JWT [OBRIGATÓRIO]
JWT_SECRET=sua_chave_secreta_jwt_aqui

# Configurações do Banco de Dados PostgreSQL [OBRIGATÓRIO]
DB_HOST=db
DB_PORT=5432
DB_NAME=autoserver
DB_USER=autoserver_user
DB_PASSWORD=autoserver_password

# Nome do banco de dados para execução de testes automatizados [OPCIONAL]
DB_TEST_NAME=autoserver_test

# Configurações de Envio de E-mail Brevo (Sendinblue) [OPCIONAL]
BREVO_API_KEY=xkeysib-exemplo_chave_aqui
BREVO_SENDER_EMAIL=seu_email@dominio.com
BREVO_SENDER_NAME=Nome do Remetente

# Configurações de Armazenamento Backblaze B2 [OPCIONAL]
BACKBLAZE_KEY_ID=seu_key_id_aqui
BACKBLAZE_APP_KEY=sua_app_key_aqui
BACKBLAZE_BUCKET=seu_bucket
BACKBLAZE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
BACKBLAZE_CDN_URL=https://s3.us-west-004.backblazeb2.com/seu_bucket
