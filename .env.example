# Autenticação Mestre da Aplicação
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123

# Cloudflare (Opcional - pode ser configurado via UI)
# Token da Cloudflare para automação de DNS (Global) [OBRIGATÓRIO]
CLOUDFLARE_API_TOKEN=seu_token_aqui

# Chave secreta para assinatura dos tokens JWT [OBRIGATÓRIO]
JWT_SECRET=sua_chave_secreta_jwt_aqui

# Configurações do Banco de Dados PostgreSQL [OBRIGATÓRIO]
DB_HOST=db
DB_PORT=5432
DB_NAME=autoserver
DB_USER=autoserver_user
DB_PASSWORD=autoserver_password